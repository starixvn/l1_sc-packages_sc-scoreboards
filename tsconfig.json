{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "module": "CommonJS",
    "declaration": true,
    "moduleResolution": "node",
    "strict": true,
    "downlevelIteration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["unit-tests"],
  "watchOptions": {
    "excludeDirectories": ["lib/*"]
  }
}
